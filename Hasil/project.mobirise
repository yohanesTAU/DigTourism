            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article11\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">        \n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        \n        <header>&gt;800 px before</header>\n         <input type=\"checkbox\" title=\"Grayscale\" name=\"grayScale1\">\n         <input type=\"color\" title=\"Color\" name=\"colorbarre2\" value=\"#9fe870\">\n         <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacitybarre2\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\">\n         <input type=\"color\" title=\"Text Color\" name=\"textColor3\" value=\"#ffffff\">\n        \n        <header>&gt;800 px after</header>\n                  <input type=\"checkbox\" title=\"Grayscale\" name=\"grayScale2\" checked>\n          <input type=\"color\" title=\"Color\" name=\"colorbarre1\" value=\"#000000\">\n         <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacitybarre1\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\">\n         <input type=\"color\" title=\"Text Color\" name=\"textColor4\" value=\"#ffffff\">\n         \n         \n         \n          <header>&lt; 800px</header>\n           <input type=\"color\" title=\"Text Color\" name=\"textColor2\" value=\"#ffffff\">\n        \n        \n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\">\n    </div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-12\">\n                \n                \n                \n<div class=\"container2\">\n  <div class=\"card\">\n    <img src=\"https://www.unsitepourtous.be/mobi/img/flower1.jpg\">\n    <div class=\"card__head\"><h2 class=\"align-center mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Flower 1</h2></div>\n  </div>\n  <div class=\"card\">\n    <img src=\"https://www.unsitepourtous.be/mobi/img/flower2.jpg\">\n    <div class=\"card__head\"><h2 class=\"align-center mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Flower 2</h2></div>\n  </div>\n  <div class=\"card\">\n    <img src=\"https://www.unsitepourtous.be/mobi/img/flower3.jpg\">\n    <div class=\"card__head\"><h2 class=\"align-center mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Flower 3</h2></div>\n  </div>\n  <div class=\"card\">\n    <img src=\"https://www.unsitepourtous.be/mobi/img/flower4.jpg\">\n    <div class=\"card__head\"><h2 class=\"align-center mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Flower 4</h2></div>\n  </div>\n  <div class=\"card\">\n    <img src=\"https://www.unsitepourtous.be/mobi/img/flower5.jpg\">\n    <div class=\"card__head\"><h2 class=\"align-center mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Flower 5</h2></div>\n  </div>\n</div>\n\n\n                </div>\n            </div>\n        </div>\n    \n</section>",
