            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "@media (min-width: 801px)": {
              ".container2": {
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "margin": "10vmin",
                "overflow": "hidden",
                "transform": "skew(5deg)",
                ".card": {
                  "flex": "1",
                  "transition": "all 1s ease-in-out",
                  "height": "50vmin",
                  "position": "relative",
                  ".card__head": {
                    "background": "rgba(red(@colorbarre2), green(@colorbarre2), blue(@colorbarre2), @overlayOpacitybarre2)",
                    "padding": "1.6px",
                    "transform": "rotate(-90deg)",
                    "transform-origin": "0% 0%",
                    "transition": "all 0.5s ease-in-out",
                    "min-width": "100%",
                    "text-align": "center",
                    "position": "absolute",
                    "bottom": "0",
                    "left": "0",
                    "white-space": "nowrap",
                    "color": "@textColor3"
                  },
                  "&:hover": {
                    "flex-grow": "10",
                    "img": {
                      "& when (@grayScale2)": {
                        "filter": "grayscale(0%)"
                      },
                      "& when (@grayScale2 = false)": {
                        "filter": "grayscale(100%)"
                      }
                    },
                    ".card__head": {
                      "text-align": "center",
                      "top": "calc(100% - 5em)",
                      "color": "@textColor4",
                      "background": "rgba(red(@colorbarre1), green(@colorbarre1), blue(@colorbarre1), @overlayOpacitybarre1)",
                      "font-size": "2em",
                      "transform": "rotate(0deg) skew(-2deg)"
                    }
                  },
                  "img": {
                    "width": "100%",
                    "height": "100%",
                    "object-fit": "cover",
                    "transition": "all 1s ease-in-out",
                    "& when (@grayScale1)": {
                      "filter": "grayscale(0%)"
                    },
                    "& when (@grayScale1 = false)": {
                      "filter": "grayscale(100%)"
                    }
                  },
                  "&:not(:nth-child(5))": {
                    "margin-right": "1em"
                  }
                }
              },
              ".mbr-section-subtitle": {
                "color": "#ffffff"
              }
            },
            "@media (max-width: 800px)": {
              ".container2": {
                "display": "flex",
                "flex-direction": "column",
                "align-items": "center",
                "padding": "20px"
              },
              ".card": {
                "margin-bottom": "20px",
                "position": "relative"
              },
              ".card img": {
                "max-width": "100%",
                "height": "auto",
                "display": "block"
              },
              ".card__head": {
                "position": "absolute",
                "bottom": "0",
                "left": "0",
                "right": "0",
                "background": "rgba(red(@colorbarre1), green(@colorbarre1), blue(@colorbarre1), @overlayOpacitybarre1)",
                "color": "@textColor2",
